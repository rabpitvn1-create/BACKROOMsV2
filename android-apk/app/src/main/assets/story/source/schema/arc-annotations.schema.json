{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "backroomsv2-story-arc-annotations-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "storyId", "levelKey", "sourceRevision", "startChapter", "chapters"],
  "properties": {
    "schemaVersion": {"const": 1},
    "storyId": {"type": "string", "minLength": 1},
    "levelKey": {"type": "string", "minLength": 1},
    "sourceRevision": {"type": "string", "minLength": 1},
    "startChapter": {"type": "string", "minLength": 1},
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "thread", "visibility"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "thread": {"type": "string", "minLength": 1},
          "visibility": {"enum": ["player", "cutaway"]},
          "nextChapter": {"type": "string"},
          "requiredFacts": {"type": "array", "items": {"type": "string"}},
          "forbiddenClaims": {"type": "array", "items": {"type": "string"}},
          "offlineDecisions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["anchor", "variants"],
              "properties": {
                "anchor": {"type": "string", "minLength": 1},
                "variants": {"type": "array", "minItems": 3, "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["canon", "trap", "converge"],
                  "properties": {
                    "canon": {"type": "string", "minLength": 1},
                    "trap": {"$ref": "#/$defs/choiceReaction"},
                    "converge": {"$ref": "#/$defs/choiceReaction"}
                  }
                }}
              }
            }
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["when", "type"],
              "properties": {
                "when": {"enum": ["ENTER", "EXIT", "AFTER_TEXT"]},
                "anchor": {"type": "string", "minLength": 1},
                "type": {"type": "string", "minLength": 1}
              },
              "allOf": [
                {"if": {"properties": {"when": {"const": "AFTER_TEXT"}}}, "then": {"required": ["anchor"]}}
              ]
            }
          }
        }
      }
    }
  },
  "$defs": {"choiceReaction": {"type": "object", "additionalProperties": false,
    "required": ["text", "reply"], "properties": {"text": {"type": "string", "minLength": 1},
      "reply": {"type": "string", "minLength": 1}}}}
}
