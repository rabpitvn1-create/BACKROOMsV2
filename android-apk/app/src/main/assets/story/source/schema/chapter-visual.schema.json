{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chapter-visual.schema.json",
  "title": "BACKROOMsV2 chapter visual annotations",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "chapterId",
    "visuals"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "chapterId": {
      "type": "string",
      "minLength": 1
    },
    "visuals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "when",
          "primaryNpcId"
        ],
        "properties": {
          "when": {
            "enum": [
              "ENTER",
              "AFTER_TEXT"
            ]
          },
          "anchor": {
            "type": "string",
            "minLength": 1
          },
          "primaryNpcId": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "acknowledgeState": {
            "enum": [
              "UNKNOWN",
              "PRESENT",
              "MISSING",
              "DECEASED"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "when": {
                  "const": "AFTER_TEXT"
                }
              }
            },
            "then": {
              "required": [
                "anchor"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "when": {
                  "const": "ENTER"
                }
              }
            },
            "then": {
              "not": {
                "required": [
                  "anchor"
                ]
              }
            }
          }
        ]
      }
    }
  }
}
